# ============================================================
# CampusConnect Production & Development Environment Variables
# ============================================================

# Core Django Settings
# Generate a random 50+ character key for production (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
SECRET_KEY=campusconnect-production-style-secret-key-2026-viva-demo

# Set DEBUG=False for production deployments
DEBUG=False

# Comma-separated list of allowed domains/IPs (e.g., campusconnect.edu,127.0.0.1,localhost)
ALLOWED_HOSTS=127.0.0.1,localhost

# Enable HTTPS/SSL security headers (HSTS, SSL redirect, secure cookies) in production
USE_HTTPS=False

# Allowed CORS Origins (leave blank to allow all or specify frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Trusted CSRF Origins
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (Dual Support: SQLite & MySQL)
# Set USE_MYSQL=True to connect to MySQL database
USE_MYSQL=False
DATABASE_NAME=campusconnect_db
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
